{
	"schemaVersion": "0.1.0",
	"name": "Substack Post",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "categories",
			"value": "[[Clippings]]",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{selector:article.newsletter-post > div a[href^=\\\"https://substack.com/@\\\"]|wikilink}}",
			"type": "multitext"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published|date:YYYY-MM-DD}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "clippings, substack",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://substack.com/home/post/"
	],
	"noteNameFormat": "{{title}}",
	"path": "Clippings"
}